-- BUTTON TOUCH HANDLERS (HAND RELEASE = STOP)
local function bindBtn(btn, onTouch, onRelease)
	btn.MouseButton1Down:Connect(onTouch)
	btn.MouseButton1Up:Connect(onRelease)
	btn.MouseLeave:Connect(onRelease)
end

