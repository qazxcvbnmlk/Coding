-- CLEANUP / RESET
---------------------------------------------------------
local function cleanupPossession()
	possessionActive = false
	FlightGui.Enabled = false
	moveVector = Vector3.zero
	turnVector = Vector2.zero

	if possessConnection then
		possessConnection:Disconnect()
		possessConnection = nil
	end

	local char = LocalPlayer.Character
	if char and char:FindFirstChildOfClass("Humanoid") then
		Camera.CameraType = Enum.CameraType.Custom
		Camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
	end

	if char and char:FindFirstChild("HumanoidRootPart") then
		char.HumanoidRootPart.Anchored = false
	end

	currentObject = nil

	Rayfield:Notify({
		Title = "👻 POSSESSION ENDED",
		Content = "Camera returned to player!",
		Duration = 2,
		Image = 4483362458,
	})
end

---------------------------------------------------------
-- EXACT TARGET POSSESSION ENGINE (PREVENT SWITCHING)
---------------------------------------------------------
local function possessGroundObject()
	if possessionActive then
		cleanupPossession()
		task.wait(0.1)
	end

	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end

	-- Precise Raycast from center screen directly to object
	local viewportSize = Camera.ViewportSize
	local centerRay = Camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {char}

	local result = Workspace:Raycast(centerRay.Origin, centerRay.Direction * maxGrabDistance, raycastParams)
	local targetPart = nil

	if result and result.Instance and result.Instance:IsA("BasePart") then
		if not result.Instance.Anchored and result.Instance ~= workspace.Terrain and result.Instance.Name ~= "Baseplate" then
			targetPart = result.Instance
		end
	end

	-- Fallback: If not looking directly at part, find closest target part within tiny radius
	if not targetPart then
		local searchCenter = result and result.Position or (char.HumanoidRootPart.Position + Vector3.new(0, 2, 0))
		local overlapParams = OverlapParams.new()
		overlapParams.FilterType = Enum.RaycastFilterType.Exclude
		overlapParams.FilterDescendantsInstances = {char}

		local nearbyParts = Workspace:GetPartBoundsInRadius(searchCenter, 15, overlapParams)
		for _, part in ipairs(nearbyParts) do
			if part:IsA("BasePart") and not part.Anchored and part ~= workspace.Terrain and part.Name ~= "Baseplate" then
				targetPart = part
				break
			end
		end
	end

	if not targetPart then
		Rayfield:Notify({
			Title = "⚠️ No Target Found",
			Content = "Look directly at the object you want to possess!",
			Duration = 2,
			Image = 4483362458,
		})
		return
	end

	pcall(function() targetPart:SetNetworkOwner(LocalPlayer) end)
	possessionActive = true
	currentObject = targetPart

	-- Enable UI
	FlightGui.Enabled = true

	-- Physics on Ground
	local bv = Instance.new("BodyVelocity")
	bv.Name = "PossessBV"
	bv.MaxForce = Vector3.new(math.huge, 0, math.huge) -- Horizontal only
	bv.Velocity = Vector3.zero
	bv.Parent = targetPart

	local bg = Instance.new("BodyGyro")
	bg.Name = "PossessBG"
	bg.MaxTorque = Vector3.new(0, math.huge, 0)
	bg.P = 20000
	bg.CFrame = targetPart.CFrame
	bg.Parent = targetPart

	Camera.CameraType = Enum.CameraType.Scriptable

	Rayfield:Notify({
		Title = "💀 OBJECT LOCKED & POSSESSED",
		Content = "Driving exact target! Release button to stop instantly.",
		Duration = 2,
		Image = 4483362458,
	})

	local currentLook = Camera.CFrame.LookVector * Vector3.new(1, 0, 1)

	possessConnection = RunService.RenderStepped:Connect(function(dt)
		if not possessionActive or not currentObject or not currentObject.Parent then
			cleanupPossession()
			return
		end

		-- Steering
		if turnVector.X ~= 0 then
			local yaw = CFrame.Angles(0, math.rad(-turnVector.X * 100 * dt), 0)
			currentLook = (CFrame.new(Vector3.zero, currentLook) * yaw).LookVector
		end

		-- Movement Input
		if moveVector.Z ~= 0 or moveVector.X ~= 0 then
			local driveDirection = (Camera.CFrame.RightVector * moveVector.X + Camera.CFrame.LookVector * (-moveVector.Z))
			driveDirection = Vector3.new(driveDirection.X, 0, driveDirection.Z).Unit
			
			bg.CFrame = CFrame.new(targetPart.Position, targetPart.Position + driveDirection)
			bv.Velocity = driveDirection * driveSpeed
		else
			-- Instant stop on release
			bv.Velocity = Vector3.zero
		end

		-- Camera follow
		Camera.CFrame = CFrame.new(targetPart.Position - (currentLook.Unit * 12) + Vector3.new(0, 5, 0), targetPart.Position)
	end)
end

